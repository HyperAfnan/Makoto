{
	"name": "backend",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"dev": "bun --watch src/index.ts",
		"build": "tsc --build --clean && tsc --build --force",
		"start": "bun run build && node dist/index.js",
		"typecheck": "tsc --noEmit",
		"test": "NODE_ENV=test bun test src/*.test.ts",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"dependencies": {
		"@google/genai": "^2.20.0",
		"apify-client": "^2.25.0",
		"cors": "^2.8.5",
		"dotenv": "^17.2.1",
		"express": "^5.1.0",
		"redis": "^5.8.2",
		"swagger-ui-express": "^5.0.1",
		"winston": "^3.17.0"
	},
	"devDependencies": {
		"@eslint/js": "^9.31.0",
		"@types/cors": "^2.8.17",
		"@types/express": "^5.0.3",
		"@types/node": "^24.1.0",
		"@types/swagger-ui-express": "^4.1.8",
		"eslint": "^9.31.0",
		"prettier": "^3.6.2",
		"tsx": "^4.19.4",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.38.0"
	}
}
