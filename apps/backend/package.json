{
  "name": "@context/backend",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --build --clean && tsc --build --force",
    "start": "bun run build && node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "NODE_ENV=test tsx --test src/*.test.ts"
  },
  "dependencies": {
    "@context/shared": "*",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "redis": "^5.8.2",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.3",
    "@types/node": "^24.1.0",
    "@types/swagger-ui-express": "^4.1.8",
    "tsx": "^4.19.4"
  }
}
